root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.cs]
indent_size = 4
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true
# Style rules are advisory in this repo; correctness rules are not.
dotnet_diagnostic.IDE0058.severity = none

[*.{json,yml,yaml,md}]
indent_size = 2

[*.sh]
indent_size = 2
