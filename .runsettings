<?xml version="1.0" encoding="utf-8"?>
<!--
  Applies to every `dotnet test` in this repository, wired in by Directory.Build.props.

  TestSessionTimeout is here because a deadlocked test used to hang the suite
  indefinitely rather than fail it: nothing in dotnet test, the CI job or the local
  gate bounds a test run, so a stuck reader waits for as long as anybody lets it.
  The number is three times a measured whole-solution run on a machine with the game
  prepared, and it is re-measured rather than guessed whenever the suite outgrows it:
  thirty minutes is three times the 10m12s that run took on 2026-09-06, and the
  game-free CI job is a few seconds of that. The previous bound was three times a
  4m57s suite and had drifted to 1.5x, where ordinary contention aborted a passing
  run - which is a bound that no longer means what this one is for.
  A run past this bound is not a slow machine, it is a hang, and a hang
  that fails is worth more than one nobody can interrupt.
  Raise the bound rather than removing it.
-->
<RunSettings>
  <RunConfiguration>
    <TestSessionTimeout>1800000</TestSessionTimeout>
  </RunConfiguration>
</RunSettings>
