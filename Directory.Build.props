<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Every project builds into build/ so the game-assembly copy in
         build/lib is on the probing path and never lands next to sources. -->
    <BaseOutputPath>$(MSBuildThisFileDirectory)build/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)build/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <!-- Every test run is bounded, however it was started. See .runsettings. -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory).runsettings</RunSettingsFilePath>

    <!-- One version for everything this repository ships, read out of the mod
         manifest the player's game reads. Nothing else declares one.

         A native recording names this build twice - once as the mod the game
         reported loaded, once as the recorder that wrote the file - and a reader
         holding the two side by side is entitled to see the same string. It did
         not: no version was set anywhere, so the assemblies carried .NET's default
         1.0.0.0 and every recording said runmobile-recorder/1.0.0.0 while the
         manifest beside it said 0.1.0.
         GodotStubs overrides this deliberately - that assembly has to keep
         GodotSharp's own identity for the game assembly's references to resolve. -->
    <RunmobileManifestPath>$(MSBuildThisFileDirectory)src/Sts2PilotTrainer.Mod/Runmobile.json</RunmobileManifestPath>
    <RunmobileVersion>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText($(RunmobileManifestPath))), '(?s)^.*?"version"\s*:\s*"([^"]*)".*$', '$1'))</RunmobileVersion>
    <Version>$(RunmobileVersion)</Version>
  </PropertyGroup>

  <!-- A regex that fails to match returns the whole file, so the extraction says so
       rather than stamping a JSON document into every assembly as its version. -->
  <Target Name="RequireAReadableRunmobileVersion" BeforeTargets="BeforeBuild">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch($(RunmobileVersion), '^[0-9]+\.[0-9]+\.[0-9]+$'))"
           Text="Could not read a version out of $(RunmobileManifestPath). Its &quot;version&quot; must be major.minor.patch; every assembly here takes its version from that one field." />
  </Target>

</Project>
