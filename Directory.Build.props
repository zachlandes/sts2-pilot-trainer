<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Every project builds into build/ so the game-assembly copy in
         build/lib is on the probing path and never lands next to sources. -->
    <BaseOutputPath>$(MSBuildThisFileDirectory)build/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)build/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <!-- Every test run is bounded, however it was started. See .runsettings. -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory).runsettings</RunSettingsFilePath>

    <!-- One version for everything this repository ships, read out of the mod
         manifest the player's game reads. Nothing else declares one.

         A native recording names this build twice - once as the mod the game
         reported loaded, once as the recorder that wrote the file - and a reader
         holding the two side by side is entitled to see the same string. It did
         not: no version was set anywhere, so the assemblies carried .NET's default
         1.0.0.0 and every recording said runmobile-recorder/1.0.0.0 while the
         manifest beside it said 0.1.0.
         GodotStubs overrides this deliberately - that assembly has to keep
         GodotSharp's own identity for the game assembly's references to resolve. -->
    <RunmobileManifestPath>$(MSBuildThisFileDirectory)src/Sts2PilotTrainer.Mod/Runmobile.json</RunmobileManifestPath>
    <RunmobileVersion>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText($(RunmobileManifestPath))), '(?s)^.*?"version"\s*:\s*"([^"]*)".*$', '$1'))</RunmobileVersion>
    <Version>$(RunmobileVersion)</Version>
  </PropertyGroup>

  <!-- The field is held to the grammar RecorderVersion reads, major.minor.patch with
       an optional -prerelease, because the release bar orders a recording's recorder
       against this one through it: a declaration that grammar cannot read would build,
       stamp every assembly, and then abort both corpus numbers at the first recording.
       A prerelease is admitted on purpose and ordered below its release there; what
       the numbers are is still not a question the build gets to decide.

       Build metadata is outside the grammar, and that one is about the round trip
       rather than the ordering. Source-stamping tools append '+<commit>' to the
       informational version and RunmobileVersion.Of has to strip it, so a declared
       0.2.0+beta would come back as 0.2.0 and sit beside a mod set saying 0.2.0+beta -
       the same two strings disagreeing that this arrangement exists to remove.

       A regex that fails to match returns the whole file, so a failed extraction is
       refused by the same condition. -->
  <Target Name="RequireAReadableRunmobileVersion" BeforeTargets="BeforeBuild">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch($(RunmobileVersion), '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$'))"
           Text="The &quot;version&quot; field of $(RunmobileManifestPath) is '$(RunmobileVersion)', which is not a version this build reads: it must be major.minor.patch, with no leading zeros, optionally followed by a -prerelease of dot-separated identifiers, and never build metadata after a '+'. Every assembly here takes its version from that one field, and the release bar orders recorders by it." />
  </Target>

</Project>
