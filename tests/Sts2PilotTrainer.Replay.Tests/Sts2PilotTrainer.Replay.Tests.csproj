<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure tests: no game assembly, and no filesystem beyond a temp directory and this
       repository's own sources. These run anywhere, including on a machine that does
       not own Slay the Spire 2. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Sts2PilotTrainer.Replay.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Sts2PilotTrainer.Replay/Sts2PilotTrainer.Replay.csproj" />
    <ProjectReference Include="../../tools/Sts2PilotTrainer.FormatReference/Sts2PilotTrainer.FormatReference.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
