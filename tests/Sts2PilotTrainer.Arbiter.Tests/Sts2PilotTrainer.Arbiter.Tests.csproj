<Project Sdk="Microsoft.NET.Sdk">

  <!-- Integration tests. Each one drives the built CLI in its own process, because
       the game engine keeps static state and a determinism claim that only holds
       inside one process is not the claim being made. Skipped, loudly, on a machine
       with no prepared game assembly. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Sts2PilotTrainer.Arbiter.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Sts2PilotTrainer.Replay/Sts2PilotTrainer.Replay.csproj" />
    <ProjectReference Include="../../third_party/godot-stubs/GodotStubs.csproj" />
    <ProjectReference Include="../../tools/Sts2PilotTrainer.Bootstrap/Sts2PilotTrainer.Bootstrap.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
