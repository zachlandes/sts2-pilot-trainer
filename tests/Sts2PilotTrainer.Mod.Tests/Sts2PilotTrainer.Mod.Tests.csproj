<Project Sdk="Microsoft.NET.Sdk">

  <!-- Executable tests for code loaded into the retail game process. Kept outside
       the game-free domain solution filter because these compile against the
       prepared game assemblies. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Sts2PilotTrainer.Arbiter.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Sts2PilotTrainer.Engine/Sts2PilotTrainer.Engine.csproj" />
    <ProjectReference Include="../../src/Sts2PilotTrainer.Mod/Sts2PilotTrainer.Mod.csproj" />
    <ProjectReference Include="../../third_party/godot-stubs/GodotStubs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Sts2PilotTrainer.Arbiter.Tests/Arbiter.cs" Link="Arbiter.cs" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
