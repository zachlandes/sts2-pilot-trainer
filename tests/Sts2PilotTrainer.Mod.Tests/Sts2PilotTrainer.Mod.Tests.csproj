<Project Sdk="Microsoft.NET.Sdk">

  <!-- Executable tests for code loaded into the retail game process. Kept outside
       the game-free domain solution filter because these compile against the
       prepared game assemblies. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Sts2PilotTrainer.Arbiter.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The game's own assembly, because a surface these tests drive names a game type
         in its signature - RunHistoryPlateHost takes the history entry's own run. A
         <Reference> does not flow through a ProjectReference, so the mod having one is
         not this project having one. -->
    <Reference Include="sts2">
      <HintPath>../../build/lib/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>../../build/lib/0Harmony.dll</HintPath>
    </Reference>
    <ProjectReference Include="../../src/Sts2PilotTrainer.Engine/Sts2PilotTrainer.Engine.csproj" />
    <ProjectReference Include="../../src/Sts2PilotTrainer.Mod/Sts2PilotTrainer.Mod.csproj" />
    <ProjectReference Include="../../third_party/godot-stubs/GodotStubs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Sts2PilotTrainer.Arbiter.Tests/Arbiter.cs" Link="Arbiter.cs" />
    <Compile Include="../Sts2PilotTrainer.Arbiter.Tests/OurAssembliesBesideThisOne.cs"
             Link="OurAssembliesBesideThisOne.cs" />
    <!-- The recorder-produced fixture, shared with the pure suite that owns it: a
         recording the mod's own patches act on has to be the same shape a recorder
         writes, and a second copy here would be a second answer. -->
    <Compile Include="../Sts2PilotTrainer.Replay.Tests/RecordedRun.cs" Link="RecordedRun.cs" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
