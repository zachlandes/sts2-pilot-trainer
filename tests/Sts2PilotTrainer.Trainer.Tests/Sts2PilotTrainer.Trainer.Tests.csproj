<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure tests over what the Combat Trainer's screen says. No game assembly, no
       Godot: the mod's wording and row rules are game-free precisely so that every
       claim the screen makes can be checked on a machine that does not own the game. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Sts2PilotTrainer.Trainer.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Sts2PilotTrainer.Trainer/Sts2PilotTrainer.Trainer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
